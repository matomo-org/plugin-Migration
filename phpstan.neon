parameters:
    level: 5
    phpVersion: 80100
    tmpDir: /tmp/phpstan/Migration/main
    paths:
        - .
    excludePaths:
        - tests/*
        - vendor/
        - github-action-tests/
    bootstrapFiles:
        - ../../bootstrap-phpstan.php
    universalObjectCratesClasses:
        - Piwik\Config
        - Piwik\View
        - Piwik\ViewDataTable\Config
    scanDirectories:
        - ../../
